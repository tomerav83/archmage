{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!package-lock.json"] },
  "formatter": { "lineWidth": 100, "indentStyle": "space", "indentWidth": 2 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "single" } },
  "css": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noDuplicateProperties": "off" }
    }
  }
}
